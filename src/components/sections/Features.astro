---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";

// Definimos el ícono SVG de check para usarlo con set:html, que es más limpio que repetir el SVG
const CheckIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
---

<section id="caracterist" class="py-16 md:py-24">
    <Container className="flex flex-col midmd:flex-row gap-12 lg:gap-20 items-center">
        
        <div class="flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col">
            <Title> 
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-teal-500 dark:from-violet-400 dark:to-teal-300">
                    Características
                </span>
            </Title>
            
            <ul class="mt-8 space-y-6 font-medium">
                
                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Alacia al 100% de forma progresiva y duradera.
                    </span>
                </li>

                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Contiene Vitamina A, Omega 6 y 9 para nutrición profunda.
                    </span>
                </li>

                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        ¡Totalmente libre de Formol! Sin vapores tóxicos.
                    </span>
                </li>

                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Compatible con cualquier tratamiento o químico previo (tintes, mechas, etc.).
                    </span>
                </li>

                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Apto para cualquier tipo de cabello, desde afro hasta teñido.
                    </span>
                </li>
                
                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Mezcla única de ácidos orgánicos, aceites y extractos vegetales.
                    </span>
                </li>
                
                <li class="flex items-start text-lg group">
                    <span class="inline-flex justify-center items-center w-7 h-7 mr-4 flex-shrink-0 
                                 bg-violet-100 dark:bg-violet-900/30 rounded-full 
                                 text-violet-600 dark:text-violet-400 
                                 font-bold transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-violet-500/20"
                          set:html={CheckIcon}>
                    </span>
                    <span class="text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 group-hover:text-gray-900 dark:group-hover:text-white">
                        Aporta brillo espejo y sedosidad, mejorando la textura capilar.
                    </span>
                </li>
            </ul>
        </div>

        <div class="max-w-md mx-auto midmd:max-w-none lg:mx-0 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto">
            <div class="w-full h-80 sm:h-96 midmd:h-full relative flex items-center justify-center">
                
                <div class="absolute inset-0 bg-gradient-to-br from-violet-600/10 to-teal-400/10 dark:from-violet-900/30 dark:to-teal-900/30 rounded-[3rem] blur-3xl transform rotate-1 scale-105 transition-all duration-700"></div>

                <div class="relative w-full h-full p-4 midmd:p-0">
                     <img 
                        class="w-auto h-full object-contain mx-auto relative z-10 
                               rounded-2xl shadow-2xl shadow-black/20 dark:shadow-violet-900/30 transition-transform duration-700 hover:scale-[1.02]" 
                        src={"/images/products.jpeg"} 
                        alt="Producto Nanoplastia UNIKA" 
                        width="1240" 
                        height="1385"
                    />
                </div>
            </div>
        </div>
    </Container>
</section>
