---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";

type ServicesProps = {
	title: string;
	description: string;
	icon: string;
	actionText?: string;
	modalId?: string;
};
---

<section id="benefic" class="py-16 md:py-24 relative overflow-hidden">

    <Container className="space-y-12">

        <div class="text-center max-w-3xl mx-auto space-y-4">
            <Title>
                <span class="text-gray-900 dark:text-white">Beneficios</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-teal-500 dark:from-violet-400 dark:to-teal-300">
                    Clave
                </span>
            </Title>

            <Paragraph className="text-gray-600 dark:text-gray-400">
                Descubre por qué la Nanoplastia UNIKA es la elección de los estilistas profesionales.
            </Paragraph>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {
                services.map((service: ServicesProps) => (
                    <Service
                        title={service.title}
                        description={service.description}
                        icon={service.icon}
                        actionText={service.actionText}
                        modalId={service.modalId}
                    />
                ))
            }
        </div>

    </Container>

</section>

<!-- Modal -->
<dialog id="modal-registro" class="rounded-xl p-0 border-none shadow-2xl backdrop:bg-black/60 outline-none">

    <div class="flex flex-col items-center bg-white dark:bg-gray-900 p-6 rounded-xl max-w-lg relative">

        <button
            class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-white"
            onclick="document.getElementById('modal-registro').close()"
        >
            ✕
        </button>

        <img
            src="/images/registro_s.jpeg"
            alt="Registro sanitario"
            class="max-w-full max-h-[75vh] rounded-lg border border-gray-100 dark:border-gray-800 shadow-sm mt-4"
        />

        <p class="mt-4 text-gray-500 text-sm font-medium">
            Registro Sanitario Costarricense
        </p>

    </div>

</dialog>