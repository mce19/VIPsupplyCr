---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";

type ServicesProps = {
	title: string;
	description: string;
	icon: string
};
---

<section id="benefic" class="py-16 md:py-24 relative overflow-hidden">
    
    <div class="absolute inset-0 top-1/4 -z-10 opacity-10 pointer-events-none">
        <div class="w-full h-full bg-gradient-to-b from-transparent via-emerald-500/5 to-transparent dark:via-emerald-900/10 rounded-full blur-[120px]"></div>
    </div>

    <Container className="space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-4">
            <Title>
                <span class="text-gray-900 dark:text-white">Beneficios</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500 dark:from-emerald-400 dark:to-teal-300">
                    Clave
                </span>
            </Title>
            <Paragraph className="text-gray-600 dark:text-gray-400">
                Descubre por qué la Nanoplastia UNIKA es la elección de los estilistas profesionales.
            </Paragraph>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {
                services.map((service: ServicesProps) => {
                    return (
                        <Service 
                            title={service.title} 
                            description={service.description} 
                            icon={service.icon} 
                            // Asumiendo que el componente Service acepta una clase para el wrapper
                            class="transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:hover:shadow-emerald-900/20"
                        >
                        </Service>
                    );
                })
            }
        </div>
    </Container>
</section>
