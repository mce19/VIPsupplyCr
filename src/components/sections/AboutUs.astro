---
import Info from "../cards/Info.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
---

<section id="result" class="py-16 md:py-24">
    <Container className="flex flex-col-reverse midmd:flex-row gap-12 lg:gap-20 items-center">
        
                <div class="flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col">
            <Title>
                                <span class="text-gray-900 dark:text-white">Alaciado en un solo paso,</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-teal-500 dark:from-violet-400 dark:to-teal-300">
                    ahorrándote tiempo y esfuerzo.
                </span>
            </Title>
            <Paragraph className="mt-8 text-gray-700 dark:text-gray-300">
                Nuestra Nanoplastia UNIKA está formulada para simplificar el proceso sin sacrificar la calidad. Logra un cabello liso, brillante y sedoso con una aplicación rápida y efectiva que beneficia tanto al profesional como a la clienta.
            </Paragraph>
            
                        <div class="pt-10 grid grid-cols-1 sm:grid-cols-2 items-stretch gap-6 max-w-3xl md:max-w-[none]">
                
                                <Info 
                    description="Distribuir la Nanoplastia UNIKA en Costa Rica, ofreciendo productos capilares de alta calidad respaldados por Agilise Cosméticos." 
                    title="Nuestra Misión"
                    class="p-5 rounded-xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow duration-300"
                >
                    <span slot="icon" class="inline-flex justify-center items-center w-8 h-8 rounded-full bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                        </svg>                              
                    </span>
                </Info>

                                <Info 
                    description="Ser el distribuidor líder en Costa Rica de productos capilares de confianza, impulsando la innovación y calidad en el cuidado del cabello." 
                    title="Nuestra Visión"
                    class="p-5 rounded-xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-md hover:shadow-lg transition-shadow duration-300"
                >
                    <span slot="icon" class="inline-flex justify-center items-center w-8 h-8 rounded-full bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </span>
                </Info>
            </div>
        </div>

                <div class="max-w-md mx-auto midmd:max-w-none lg:mx-0 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto order-first midmd:order-last">
            <div class="w-full h-80 sm:h-96 midmd:h-full relative flex items-center justify-center">
                
                <div class="absolute inset-0 bg-gradient-to-br from-violet-600/10 to-teal-400/10 dark:from-violet-900/30 dark:to-teal-900/30 rounded-[3rem] blur-3xl transform rotate-1 scale-105 transition-all duration-700"></div>

                <div class="relative w-full h-full p-4 midmd:p-0">
                    <img 
                        class="w-auto h-full object-contain mx-auto relative z-10 
                               rounded-2xl shadow-2xl shadow-black/20 dark:shadow-violet-900/30 transition-transform duration-700 hover:scale-[1.02]" 
                        src={"/images/Unika-resultado.jpg"} 
                        alt="Resultado de Nanoplastia UNIKA" 
                        width="1240" 
                        height="1385"
                    />
                </div>
            </div>
        </div>
    </Container>
</section>

<style>
/* Si el componente Info.astro es muy simple, las siguientes clases podrían ser necesarias para darle estructura */
/* Sin acceso al código de Info.astro, nos limitamos a estilizar su contenedor */
</style>
