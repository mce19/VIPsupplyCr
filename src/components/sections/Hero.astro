---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";

const WhatsappIcon = `<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.232-.298.347-.497.115-.198.058-.372-.029-.546-.087-.174-.787-1.898-1.078-2.6-.284-.686-.572-.591-.787-.602-.204-.006-.437-.007-.67-.007-.233 0-.612.087-.932.435-.32.347-1.223 1.196-1.223 2.916 0 1.72 1.251 3.382 1.425 3.615.174.233 2.463 3.761 5.967 5.273 2.352 1.014 2.83.812 3.858.762 1.028-.05 2.173-.888 2.478-1.745.304-.857.304-1.591.214-1.744-.09-.153-.323-.228-.62-.377z"/></svg>`;
---

<section class="relative pt-32 lg:pt-40 pb-20 overflow-hidden">
    
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-primary/10 dark:bg-primary/20 blur-[100px]"></div>
        <div class="absolute top-[20%] right-0 w-[30%] h-[30%] rounded-full bg-violet-400/10 dark:bg-violet-500/10 blur-[80px]"></div>
    </div>

    <Container className={"flex flex-col lg:flex-row items-center gap-12 lg:gap-20"}>
        
        <div class="flex flex-col items-center lg:items-start text-center lg:text-left lg:w-1/2 z-10">
            
            <span class="px-3 py-1 mb-6 text-xs font-bold tracking-widest uppercase rounded-full 
                         text-violet-700 bg-violet-100/50 border border-violet-200
                         dark:text-violet-300 dark:bg-violet-900/30 dark:border-violet-700/50">
                Calidad Profesional
            </span>

            <h1 class="text-4xl sm:text-5xl xl:text-6xl font-bold leading-[1.15] text-gray-900 dark:text-white">
                Nanoplastia <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r 
                             from-violet-700 via-teal-500 to-violet-600
                             dark:from-violet-400 dark:via-teal-200 dark:to-violet-400 drop-shadow-sm">
                    UNIKA Costa Rica
                </span>
            </h1>

            <Paragraph className="mt-6 text-lg text-gray-600 dark:text-gray-300 max-w-lg">
                Descubre la revolución en alisado capilar. Suplidora oficial de 
                <span class="text-gray-900 dark:text-white font-semibold">Nanoplastia UNIKA</span>, 
                la fórmula más eficaz y segura del mercado para resultados impecables.
            </Paragraph>

            <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full justify-center lg:justify-start">
                <a href="https://wa.me/50688900721?text=Quiero%20comprar%20la%20nanoplastia%20UNIKA" 
                   class="group relative flex items-center justify-center px-8 py-4 text-base font-semibold text-white transition-all duration-200 bg-primary rounded-full hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/30 hover:-translate-y-1">
                   <span set:html={WhatsappIcon}></span>
                   Comprar Ahora
                </a>
                
                <a href="#caracterist"
   class="px-8 py-4 text-base font-semibold transition-all duration-200 rounded-full 
   text-gray-700 bg-white border border-gray-200 hover:bg-gray-50
   dark:bg-transparent dark:text-gray-200 dark:border-gray-700 dark:hover:bg-gray-800 dark:hover:border-gray-600">
    Ver características
</a>
            </div>
            
            <div class="mt-8 pt-8 border-t border-gray-100 dark:border-gray-800 flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                <div class="flex -space-x-2">
                    <span class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 border-2 border-white dark:border-gray-900"></span>
                    <span class="w-8 h-8 rounded-full bg-gray-300 dark:bg-gray-600 border-2 border-white dark:border-gray-900"></span>
                    <span class="w-8 h-8 rounded-full bg-gray-400 dark:bg-gray-500 border-2 border-white dark:border-gray-900"></span>
                </div>
                <p>Elegido por +500 estilistas</p>
            </div>
        </div>

        <div class="relative w-full lg:w-1/2 flex justify-center lg:justify-end mt-12 lg:mt-0">
            <div class="absolute inset-0 bg-gradient-to-tr from-primary to-violet-400 opacity-20 blur-2xl rounded-full transform rotate-3 scale-90 lg:scale-100"></div>
            
            <div class="relative w-full max-w-[500px] aspect-[4/5] lg:aspect-square rounded-[2rem] overflow-hidden 
                        shadow-2xl shadow-gray-300/50 dark:shadow-black/50 
                        border border-white/50 dark:border-gray-700/50 
                        bg-white dark:bg-gray-800">
                <video 
                    playsinline 
                    autoplay 
                    muted 
                    loop 
                    class="w-full h-full object-cover transform transition-transform duration-700 hover:scale-105"
                >
                    <source src="/video/resultado-unika-video.mp4" type="video/mp4">
                    Tu navegador no soporta videos HTML5.
                </video>
                
                <div class="absolute inset-0 pointer-events-none ring-1 ring-inset ring-black/5 dark:ring-white/5 rounded-[2rem]"></div>
            </div>
            
            <div class="absolute -bottom-6 left-4 lg:bottom-10 lg:-left-10 p-4 rounded-2xl shadow-xl animate-bounce-slow 
                        bg-white shadow-black/5 
                        dark:bg-gray-800 dark:shadow-black/30 dark:border dark:border-gray-700
                        flex items-center gap-3 z-20">
                <div class="w-10 h-10 rounded-full flex items-center justify-center 
                            bg-violet-100 text-violet-600
                            dark:bg-violet-900/30 dark:text-violet-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Producto</p>
                    <p class="text-sm font-bold text-gray-900 dark:text-white whitespace-nowrap">100% Original</p>
                </div>
            </div>

        </div>
    </Container>
</section>

<style>
    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s infinite ease-in-out;
    }
</style>
